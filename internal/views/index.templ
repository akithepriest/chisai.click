package views

const InputFieldClass = "p-3 text-white bg-zinc-800 w-full"

templ Index() {
	@Layout("chisai.click") {
		<div class="flex min-h-screen items-center justify-center flex-col w-full bg-zinc-900">
			<div id="info" class="text-white w-full max-w-lg p-6 transition-all flex flex-col">
				<div id="info-d" class="hidden bg-white p-6 rounded-lg shadow-xl"></div>
				<div id="keyword" class="text-xl font-semibold mt-4"></div>
				<div id="link" class="text-lg text-zinc-400 mt-2"></div>
				<div id="error" class="hidden bg-red-500 text-black p-3 font-bold mt-4 rounded-md"></div>
			</div>
			<form class="flex flex-col space-y-4 w-full max-w-md p-6 rounded-lg shadow-lg bg-zinc-800 transition-all" id="form">
				<label for="keyword-input" class="text-white font-semibold">Keyword</label>
				<input type="text" name="keyword" id="keyword-input" placeholder="e.g, github"
				class="text-zinc-400 p-3 rounded-md border border-zinc-600 focus:outline-none focus:ring-2 focus:ring-orange-500" />

				<label for="link-input" class="text-white font-semibold">Link</label>
				<input type="url" name="link" id="link-input" placeholder="e.g, https://github.com"
				class="text-zinc-400 p-3 rounded-md border border-zinc-600 focus:outline-none focus:ring-2 focus:ring-orange-500" />

				<button class="bg-orange-500 text-black p-3 font-bold rounded-md w-full mt-4 hover:bg-orange-400 transition-all"
				hx-post="/api/create" hx-swap="innerHTML" hx-target="#info-d" hx-trigger="click">Create</button>
			</form>
		</div>
		<script>
			const form = document.querySelector("#form");
			const infoDiv = document.querySelector("#info");
			const errorDiv = document.querySelector("#error");

			document.body.addEventListener('htmx:afterSwap', function(event) {
				if (event.target.id === "info-d") {
					try {
						let jsonResponse = JSON.parse(event.target.innerHTML);

						document.querySelector("#keyword").innerHTML = `Keyword: <span class="font-bold text-orange-500">${jsonResponse.d.Keyword}</span>`;
						document.querySelector("#link").innerHTML = `Generated Link: <a href="https://chisai.click/${jsonResponse.d.Keyword}" target="_blank" class="text-orange-500">chisai.click/${jsonResponse.d.Keyword}</a>`;

						const copyButton = document.createElement('button');
						copyButton.innerHTML = 'Copy to clipboard';
						copyButton.classList.add('bg-orange-500', 'text-black', 'p-3', 'mt-4', 'rounded-md', 'hover:bg-orange-400', 'transition-all', 'font-bold');
						copyButton.addEventListener('click', () => {
							const link = `https://chisai.click/${jsonResponse.d.Keyword}`;
							navigator.clipboard.writeText(link).then(() => {
								alert("Link copied to clipboard!");
							});
						});
						document.querySelector("#info").appendChild(copyButton);

						const refreshButton = document.createElement('button');
						refreshButton.innerHTML = 'Create another link';
						refreshButton.classList.add('bg-zinc-700', 'text-white', 'p-3', 'mt-4', 'rounded-md', 'hover:bg-zinc-600', 'transition-all', 'font-bold');
						refreshButton.addEventListener('click', () => {
							location.reload();
						});
						document.querySelector("#info").appendChild(refreshButton);

						form.classList.add("opacity-0", "pointer-events-none", "transition-all", "duration-500", "transform", "-translate-y-6");
						setTimeout(() => form.classList.add("hidden"), 500);

						document.querySelector("#error").classList.add("hidden");

						infoDiv.classList.remove("opacity-0");
						infoDiv.classList.add("opacity-100", "transition-all", "duration-500");
					} catch (error) {
						console.error("Failed to format JSON:", error);
					}
				}
			});

			document.body.addEventListener('htmx:responseError', function(event) {
				const xhr = event.detail.xhr;
				let errorMessage = "An unknown error occurred.";

				try {
					let errorResponse = xhr.response;
					let errorJson = JSON.parse(errorResponse);
					if (errorJson.d) {
						errorMessage = errorJson.d;
					}
				} catch (parseError) {
					console.error("Failed to parse error response:", parseError);
					errorMessage = xhr.statusText;
				}

				errorDiv.innerHTML = `Error: ${xhr.status} - ${errorMessage}`;
				errorDiv.classList.remove("hidden");
			});
		</script>
	}
}
